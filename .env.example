# Authentication Credentials
# Copy this file to .env and update with your credentials
LOGIN_USERNAME=""
LOGIN_PASSWORD=""

# Supabase Configuration (for CSV file storage)
# Get these from your Supabase project settings
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# For private buckets, use service_role key instead (more secure)
# SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_BUCKET="data"  # Name of the storage bucket (default: "data")
SUPABASE_SERVICE_KEY=""
